{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schedulepilot",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "workers_dev": true,
  "preview_urls": false,
  // Every host below redirects to APP_URL.
  "routes": [
    { "pattern": "schedulepilot.dev", "custom_domain": true },
    { "pattern": "www.schedulepilot.dev", "custom_domain": true },
    { "pattern": "schedulepilot.felixlenci.com", "custom_domain": true },
  ],
  "vars": {
    "APP_URL": "https://schedulepilot.dev",
  },
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "triggers": {
    "crons": ["*/20 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
